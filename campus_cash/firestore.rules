rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper authentication functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection rules
    // Users can read any profile for name, rating, and exchange counts
    // Users can only create and edit their own profiles, except completedExchanges counter
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedExchanges'])
      );
      allow delete: if false;
    }

    // 2. Exchange requests collection rules
    // Authenticated users can read searching requests to identify matches
    // Users can only create requests belonging to their UID
    // Users can update their own request, counterparty request in atomic match, or when matched
    match /exchangeRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.matchedUserId == request.auth.uid ||
        resource.data.status == 'searching'
      );
      allow delete: if isOwner(resource.data.userId);
    }

    // 3. Completed exchanges history collection rules
    // Only participants can read or create completed records
    match /exchanges/{exchangeId} {
      allow read: if isAuthenticated() && (
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds) ||
        resource.data.userAId == request.auth.uid || 
        resource.data.userBId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.userAId == request.auth.uid || 
        request.resource.data.userBId == request.auth.uid
      );
      allow delete: if false;
    }

    // 4. Notifications collection rules
    // Users can only read and manage their own notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated();
    }

    // 5. Exchange Meetup Coordination Chat
    match /exchangeChats/{chatId}/messages/{messageId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
